<base:BaseArtWizWindow x:Class="ArtWiz.View.InputWindow"
					   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					   xmlns:local="clr-namespace:ArtWiz.View"
					   xmlns:cvt="clr-namespace:ArtWiz.View.Utils"
					   xmlns:base="clr-namespace:ArtWiz.View.Base"
					   SizeToContent="WidthAndHeight"
					   xmlns:def="clr-namespace:ArtWiz"
					   MinHeight="200"
					   Title="Select Options"
					   WindowStartupLocation="CenterScreen"
					   WindowStyle="None"
					   Height="Auto"
					   FontFamily="{StaticResource ResourceKey={x:Static def:Definitions.FontFiraSans_Regular}}"
					   Background="{StaticResource {x:Static def:Definitions.PanelBackgroundLevel0_1}}"
					   BorderBrush="{StaticResource {x:Static def:Definitions.PanelBackgroundLevel0_10}}"
					   BorderThickness="1"
					   MinWidth="350">


	<Window.Resources>
		<local:InputWindowItemHeightConverter x:Key="tcvt" />
		<cvt:BoolToVisibilityConverter x:Key="bcvt" />
		<Style x:Key="HeaderTextStyle"
			   TargetType="TextBlock">
			<Setter Property="FontSize"
					Value="20" />
			<Setter Property="FontWeight"
					Value="Bold" />
			<Setter Property="Foreground"
					Value="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}" />
			<Setter Property="Margin"
					Value="0,0,0,10" />
		</Style>

		<Style x:Key="DescriptionTextStyle"
			   TargetType="TextBlock">
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="Foreground"
					Value="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}" />
			<Setter Property="TextWrapping"
					Value="Wrap" />
			<Setter Property="Margin"
					Value="0,0,0,20" />
		</Style>

		<Style x:Key="RadioButtonStyle"
			   TargetType="RadioButton">
			<Setter Property="Margin"
					Value="0,0,0,10" />
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="Foreground"
					Value="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}" />
		</Style>

		<Style x:Key="ButtonStyle"
			   TargetType="Button">
			<Setter Property="Width"
					Value="100" />
			<Setter Property="Height"
					Value="35" />
			<Setter Property="Margin"
					Value="5,0" />
			<Setter Property="FontSize"
					Value="14" />
		</Style>

		<ControlTemplate TargetType="Control"
						 x:Key="TextInputItem">
			<TextBox Text="{Binding Content}"
					 Margin="5"
					 PreviewTextInput="TextBox_PreviewTextInput"
					 Height="20" />
		</ControlTemplate>

		<ControlTemplate TargetType="Control"
						 x:Key="CheckBoxInputItem">
			<CheckBox IsChecked="{Binding CheckContent}"
					  Margin="5"
					  Checked="CheckBox_Checked"
					  Unchecked="CheckBox_Checked"
					  Height="20" />
		</ControlTemplate>

		<ControlTemplate TargetType="Control"
						 x:Key="ComboBoxInputItem">
			<ComboBox ItemsSource="{Binding ComboOptions}"
					  Margin="5"
					  SelectedIndex="{Binding ComboSelection}"
					  Height="20" />
		</ControlTemplate>
		<ControlTemplate TargetType="Control"
						 x:Key="InlineRadioInput">
			<ItemsControl ItemsSource="{Binding InlineRadioOptions}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<RadioButton Content="{Binding .}"
									 Margin="5"
									 Checked="InlineRadio_Checked"
									 GroupName="{Binding Path=DataContext.Title, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ControlTemplate>
		<ControlTemplate TargetType="Control"
						 x:Key="RadioInput">
			<RadioButton Content="{Binding Title}"
						 Margin="5"
						 Checked="InlineRadio_Checked"
						 GroupName="{Binding RadioOptionGroup}" />
		</ControlTemplate>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Content -->
		<Grid Grid.Row="1"
			  Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Header -->
			<StackPanel Grid.Row="0">
				<TextBlock Text="Select Your Options"
						   Style="{StaticResource HeaderTextStyle}" />
				<TextBlock Text="Please choose from the following options to customize your experience within the ArtWiz app."
						   Style="{StaticResource DescriptionTextStyle}" />
			</StackPanel>


			<!-- Header -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<ListView x:Name="TitleListView"
						  ScrollViewer.CanContentScroll="False"
						  BorderThickness="0"
						  ScrollViewer.VerticalScrollBarVisibility="Disabled">
					<ListView.ItemContainerStyle>
						<Style TargetType="ListViewItem">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListViewItem">
										<Grid>
											<TextBlock Text="{Binding Title}"
													   ToolTip="{Binding Description}"
													   Margin="5"
													   TextWrapping="Wrap"
													   MaxWidth="150"
													   MinHeight="20" />
											<Rectangle Fill="#667F7F7F"
													   ToolTip="{Binding Description}"
													   Visibility="{Binding IsDisabled, Converter={StaticResource bcvt}}" />
										</Grid>
										<ControlTemplate.Triggers>
											<DataTrigger Binding="{Binding ContentType}"
														 Value="RADIO">
												<Setter Property="Visibility"
														Value="Hidden" />
											</DataTrigger>
											<DataTrigger Binding="{Binding ContentType}"
														 Value="RADIO">
												<Setter Property="Width"
														Value="0" />
											</DataTrigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemTemplate>
						<DataTemplate>
							<TextBox Text="{Binding Content}" />
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>

				<ListView x:Name="InputListView"
						  ScrollViewer.CanContentScroll="False"
						  BorderThickness="0"
						  MinWidth="300"
						  Grid.Column="1"
						  ScrollViewer.VerticalScrollBarVisibility="Disabled">
					<ListView.ItemContainerStyle>
						<Style TargetType="ListViewItem">
							<EventSetter Event="PreviewTextInput"
										 Handler="TextBox_PreviewTextInput" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListViewItem">
										<Grid>
											<Control>
												<Control.Height>
													<MultiBinding Converter="{StaticResource tcvt}">
														<Binding ElementName="TitleListView" />
														<Binding ElementName="InputListView"
																 Path="ItemsSource" />
														<Binding Path="." />
													</MultiBinding>
												</Control.Height>
												<Control.Style>
													<Style TargetType="Control">
														<Style.Triggers>
															<DataTrigger Binding="{Binding ContentType}"
																		 Value="TEXT">
																<Setter Property="Template"
																		Value="{StaticResource TextInputItem}" />
															</DataTrigger>
															<DataTrigger Binding="{Binding ContentType}"
																		 Value="CHECKBOX">
																<Setter Property="Template"
																		Value="{StaticResource CheckBoxInputItem}" />
															</DataTrigger>
															<DataTrigger Binding="{Binding ContentType}"
																		 Value="COMBO">
																<Setter Property="Template"
																		Value="{StaticResource ComboBoxInputItem}" />
															</DataTrigger>
															<DataTrigger Binding="{Binding ContentType}"
																		 Value="INLINE_RADIO">
																<Setter Property="Template"
																		Value="{StaticResource InlineRadioInput}" />
															</DataTrigger>
															<DataTrigger Binding="{Binding ContentType}"
																		 Value="RADIO">
																<Setter Property="Template"
																		Value="{StaticResource RadioInput}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Control.Style>
											</Control>

											<Rectangle Fill="#667F7F7F"
													   Visibility="{Binding IsDisabled, Converter={StaticResource bcvt}}" />
										</Grid>

									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListView.ItemContainerStyle>
				</ListView>
			</Grid>

			<!-- Buttons -->
			<StackPanel Grid.Row="2"
						Orientation="Horizontal"
						HorizontalAlignment="Right"
						Margin="0,20,0,0">
				<Button Content="Confirm"
						Style="{StaticResource ButtonStyle}"
						Background="{StaticResource {x:Static def:Definitions.ButtonAndIconBrushLevel1}}"
						Foreground="White"
						BorderThickness="0"
						Click="ButtonAgreeClick" />
				<Button Content="Cancel"
						Style="{StaticResource ButtonStyle}"
						Background="Transparent"
						Foreground="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}"
						BorderThickness="1"
						BorderBrush="{StaticResource {x:Static def:Definitions.PanelBackgroundLevel0_10}}"
						Click="ButtonCancelClick" />
			</StackPanel>
		</Grid>
	</Grid>
</base:BaseArtWizWindow>
