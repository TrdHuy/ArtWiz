<base:BaseArtWizWindow
    x:Class="ArtWiz.View.OptionsPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:base="clr-namespace:ArtWiz.View.Base"
    xmlns:def="clr-namespace:ArtWiz"
    xmlns:wg="clr-namespace:ArtWiz.View.Widgets"
    mc:Ignorable="d"
    Title="Select Options"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Height="Auto"
    Background="{StaticResource {x:Static def:Definitions.PanelBackgroundLevel0_1}}"
    BorderBrush="{StaticResource {x:Static def:Definitions.PanelBackgroundLevel0_10}}"
    BorderThickness="1"
    MaxWidth="400"
    MinWidth="350"
    >


    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="DescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Select Your Options"
                         Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock Text="Please choose from the following options to customize your experience within the ArtWiz app."
                         Style="{StaticResource DescriptionTextStyle}"/>
            </StackPanel>

            <!-- Options List -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          MaxHeight="300">
                <StackPanel x:Name="OptionsPanel">
                    <!-- Options will be added here dynamically -->
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <Button Content="Confirm"
                        Style="{StaticResource ButtonStyle}"
                        Background="{StaticResource {x:Static def:Definitions.ButtonAndIconBrushLevel1}}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ConfirmButton_Click"/>
                <Button Content="Cancel"
                        Style="{StaticResource ButtonStyle}"
                        Background="Transparent"
                        Foreground="{StaticResource {x:Static def:Definitions.TextForegroundBrushLevel0}}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource {x:Static def:Definitions.PanelBackgroundLevel0_10}}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</base:BaseArtWizWindow>